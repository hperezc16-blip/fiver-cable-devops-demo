FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=3001
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/__init__.py src/__init__.py
COPY src/common src/common
COPY src/ms_catalogo src/ms_catalogo
RUN useradd --create-home appuser
USER appuser
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD python -c "import urllib.request,os;urllib.request.urlopen('http://localhost:'+os.environ['PORT']+'/health')"
CMD ["sh", "-c", "uvicorn src.ms_catalogo.main:app --host 0.0.0.0 --port $PORT"]
